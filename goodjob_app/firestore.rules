rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function isTrabajadorAsignado(trabajoId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/trabajos/$(trabajoId)).data.trabajadorAsignadoId == request.auth.uid;
    }

    function isPropietarioPostulacionUsuario(usuarioId, postulacionId) {
      return isSignedIn() &&
        request.auth.uid == usuarioId &&
        resource.data.usuarioId == request.auth.uid &&
        resource.data.trabajoId == postulacionId &&
        (
          !request.resource.data.keys().hasAny(['usuarioId']) ||
          request.resource.data.usuarioId == request.auth.uid
        ) &&
        (
          !request.resource.data.keys().hasAny(['trabajoId']) ||
          request.resource.data.trabajoId == postulacionId
        );
    }


    match /usuarios/{usuarioId} {
      allow create: if isSignedIn() && request.auth.uid == usuarioId;

      allow read, update: if isSignedIn() && request.auth.uid == usuarioId;
      allow read, update, delete: if isAdmin();

      match /fcm_tokens/{tokenId} {
        allow read: if isSignedIn() && request.auth.uid == usuarioId;
        allow create, update, delete: if isSignedIn() && request.auth.uid == usuarioId;
      }

      match /postulaciones/{postulacionId} {
        allow read: if isAdmin() ||
          (isSignedIn() && request.auth.uid == usuarioId);
        allow create: if isSignedIn() &&
          request.auth.uid == usuarioId &&
          request.resource.data.usuarioId == request.auth.uid &&
          request.resource.data.trabajoId == postulacionId;
        allow update: if isAdmin() || (
          isPropietarioPostulacionUsuario(usuarioId, postulacionId) &&
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'estado',
              'fechaAceptacion',
              'trabajoTitulo',
              'confirmadoEn',
              'confirmarAntesDe',
              'aceptadoEn',
              'liberadoPorExpiracionEn',
              'estadoTrabajo',
              'trabajoCompletado',
              'pendienteRevisionEn',
              'estadoAsignacion'
            ])
        );
        allow delete: if isAdmin() || (
          isSignedIn() &&
          request.auth.uid == usuarioId &&
          resource.data.usuarioId == request.auth.uid &&
          resource.data.trabajoId == postulacionId
        );
      }
    }

    match /trabajos/{trabajoId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isTrabajadorAsignado(trabajoId) &&
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly([
            'estado',
            'trabajadorAsignadoId',
            'estadoAsignacion',
            'confirmadoEn',
            'confirmacionExpiradaEn'
          ]) &&
        (
          !request.resource.data.keys().hasAny(['trabajadorAsignadoId']) ||
          request.resource.data.trabajadorAsignadoId == request.auth.uid
        )
      );

      match /evidencias/{evidenciaId} {
        allow read: if isAdmin() || isTrabajadorAsignado(trabajoId);
        allow create, update: if (isAdmin() || isTrabajadorAsignado(trabajoId)) &&
          request.resource.data.uploadedBy == request.auth.uid;
        allow delete: if isAdmin() || (isTrabajadorAsignado(trabajoId) &&
          resource.data.uploadedBy == request.auth.uid);
      }

      match /evidenciasPagos/{evidenciaId} {
        allow read: if isAdmin() || isTrabajadorAsignado(trabajoId);
        allow create, update: if isAdmin() &&
          request.resource.data.uploadedBy == request.auth.uid;
        allow delete: if isAdmin();
      }
      
      match /postulaciones/{postulacionId} {
        allow create: if isSignedIn() &&
          request.resource.data.usuarioId == request.auth.uid &&
          request.resource.data.trabajoId == trabajoId;
        allow read: if isAdmin() ||
          (isSignedIn() && resource.data.usuarioId == request.auth.uid);
        allow update: if isAdmin() || (
          isSignedIn() &&
          postulacionId == request.auth.uid &&
          resource.data.usuarioId == request.auth.uid &&
          (
            !request.resource.data.keys().hasAny(['usuarioId']) ||
            request.resource.data.usuarioId == request.auth.uid
          ) &&
          (
            !request.resource.data.keys().hasAny(['trabajoId']) ||
            request.resource.data.trabajoId == trabajoId
          ) &&
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'estado',
              'fechaAceptacion',
              'confirmadoEn',
              'confirmarAntesDe',
              'aceptadoEn',
              'liberadoPorExpiracionEn'
            ])
        );
        allow delete: if isAdmin() || (
          isSignedIn() &&
          resource.data.usuarioId == request.auth.uid &&
          postulacionId == request.auth.uid
        );
      }
    }

    match /notificaciones_admin/{notificacionId} {
      allow create: if isSignedIn() &&
        request.resource.data.postulanteId == request.auth.uid &&
        request.resource.data.tipo in ['confirmacion_trabajo', 'confirmacion_expirada'];
      allow read, update, delete: if isAdmin();
    }
    
    match /trabajoPlantillas/{plantillaId} {
      allow read, create, update, delete: if isAdmin();
    }
    
    match /perfiles/{perfilId} {
      allow create, read, update: if isSignedIn() && request.auth.uid == perfilId;
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == perfilId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}