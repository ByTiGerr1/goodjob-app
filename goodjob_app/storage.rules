rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function getUsuario(uid) {
      return firestore.get(/databases/(default)/documents/usuarios/$(uid));
    }

    function getPostulacion(trabajoId, uid) {
      return firestore.get(
        /databases/(default)/documents/trabajos/$(trabajoId)/postulaciones/$(uid)
      );
    }

    function getTrabajo(trabajoId) {
      return firestore.get(/databases/(default)/documents/trabajos/$(trabajoId));
    }

    function isAdmin() {
      if (!isSignedIn()) {
        return false;
      }
      let usuario = getUsuario(request.auth.uid);
      return usuario.data != null && usuario.data.rol == 'admin';
    }

    function isTrabajadorAsignado(trabajoId) {
      if (!isSignedIn()) {
        return false;
      }
      let postulacion = getPostulacion(trabajoId, request.auth.uid);
      let trabajo = getTrabajo(trabajoId);
      return (postulacion.data != null && postulacion.data.estado == 'confirmado') ||
        (trabajo.data != null && trabajo.data.trabajadorAsignadoId == request.auth.uid);
    }

    match /profile_pictures/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /trabajos/{trabajoId} {
      match /principal/{fileName} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }

      match /evidencias/{usuarioId}/{fileName} {
        allow read: if isAdmin() || isTrabajadorAsignado(trabajoId);
        allow write: if request.auth != null && (
          isAdmin() ||
          (request.auth.uid == usuarioId && isTrabajadorAsignado(trabajoId))
        );
        allow delete: if isAdmin() || (request.auth != null &&
          request.auth.uid == usuarioId && isTrabajadorAsignado(trabajoId));
      }

      match /evidenciasPagos/{fileName} {
        allow read: if isAdmin() || isTrabajadorAsignado(trabajoId);
        allow write: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /Evidencias/{trabajoId}/{usuarioId}/{fileName} {
      allow read: if isAdmin() || isTrabajadorAsignado(trabajoId);
      allow write: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == usuarioId && isTrabajadorAsignado(trabajoId))
      );
      allow delete: if isAdmin() || (request.auth != null &&
        request.auth.uid == usuarioId && isTrabajadorAsignado(trabajoId));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}